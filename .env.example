# ==============================================================================
# Job Scout AI - Environment Configuration Template
# ==============================================================================

# Database Configuration (PostgreSQL with pgvector)
# For local host execution use localhost:5435, for Docker internal use db:5432
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5435/job_scout

# Redis Configuration (Broker & Task Queue)
# For local host execution use localhost:6380, for Docker internal use redis:6379
REDIS_URL=redis://localhost:6380/0

# Security & Admin Authentication
ADMIN_API_KEY=jobscout_admin_k3y_2026

# AI Execution Mode: "demo" (lightweight/mock inference) | "cuda" (NVIDIA GPU) | "cpu" (Local PyTorch)
AI_DEVICE_MODE=demo

# Offline Model Inference Flags (prevents runtime downloads if pre-cached)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8001
